# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
# Gradle and Flutter plugin build outputs regenerate on every build.
android/build/
packages/*/build/
# A Flutter plugin package builds into its own directory too; the root
# rule above only covers the app.
packages/*/build/
# Gradle and Flutter plugin build outputs regenerate on every build.
android/build/
packages/*/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Release signing material. The upload key is the project's identity; committing it
# would let anyone who clones the repository publish as this application.
android/key.properties
*.jks
*.keystore
