; Phantrix split-tunnel callout driver.
;
; This is a non-PnP kernel service. It is installed by the elevated helper with
; CreateService (SERVICE_KERNEL_DRIVER), not by pnputil, because there is no
; hardware device to enumerate. The INF is kept so the package can be signed
; and installed as one unit, and so the service's binary path and start type
; are documented beside the code they describe.

[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderName%
CatalogFile=phantrix_split_tunnel.cat
DriverVer=11/12/2026,1.0.0.0
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=12

[DefaultInstall.NT]
CopyFiles=DriverCopyFiles

[DefaultInstall.NT.Services]
AddService=PhantrixSplitTunnel,0x00000002,DriverService

[DriverCopyFiles]
phantrix_split_tunnel.sys,,,0x00000004

[DriverService]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\phantrix_split_tunnel.sys

[Strings]
ProviderName="Phantrix"
ServiceName="Phantrix split tunnel"
