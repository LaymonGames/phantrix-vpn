<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	package="dev.phantrix.phantrix_platform">

	<!--
	  The app fetches the public server list over HTTPS. The plugin itself
	  opens no sockets; this permission is declared here because the library
	  manifest is where the app inherits it from.

	  Nothing else is declared. There is no tunnel service on Android in this
	  build, so there is no BIND_VPN_SERVICE, no foreground service type and
	  no boot receiver to go with one.
	-->
	<uses-permission android:name="android.permission.INTERNET" />

	<application android:allowBackup="false" />

</manifest>
