<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	package="dev.phantrix.phantrix_platform">

	<!--
	  BIND_VPN_SERVICE is declared so the system will let this app own a VPN.
	  It has existed since API 21 and still exists, so it is deliberately NOT
	  capped with maxSdkVersion: capping it would leave the app without the
	  permission on newer releases and the system would refuse the bind.
	-->
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.BIND_VPN_SERVICE" />

	<!--
	  Android 14 (API 34) requires a foreground service type. There is no
	  "vpn" type, so a VPN tunnel uses `specialUse` and must declare the
	  matching FOREGROUND_SERVICE_SPECIAL_USE permission. Declaring
	  FOREGROUND_SERVICE_SYSTEM instead would not grant the right the platform
	  actually checks for this type.
	-->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

	<application android:allowBackup="false">

		<!--
		  exported=false: no other app may start the tunnel. The only way in is
		  the system binding it, which is gated by BIND_VPN_SERVICE below.
		  stopWithTask=false: swiping the app away must not drop the tunnel.
		-->
		<service
			android:name=".PhantrixTunnelService"
			android:exported="false"
			android:foregroundServiceType="specialUse"
			android:permission="android.permission.BIND_VPN_SERVICE"
			android:stopWithTask="false">
			<intent-filter>
				<action android:name="android.net.VpnService" />
			</intent-filter>
			<!--
			  Required alongside specialUse from Android 14 onwards: the platform
			  refuses to start the service without a declared subtype.
			-->
			<property
				android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
				android:value="vpn" />
		</service>

	</application>

</manifest>